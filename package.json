{
  "name": "mass-flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "run-p dev:app docs:dev",
    "dev:app": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:run": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "docs:dev": "vitepress dev docs --port 5174",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 5174",
    "docs:type-check": "vue-tsc -p docs/.vitepress/tsconfig.json --noEmit",
    "icons:bundle": "node scripts/build-icon-bundle.mjs",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache --quiet",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check src/",
    "check": "run-p type-check lint:check test:unit:run"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tdesign-vue-next/chat": "^0.6.0",
    "@zip.js/zip.js": "^2.8.26",
    "ali-oss": "^6.23.0",
    "axios": "^1.13.2",
    "cordis": "^4.0.0-rc.9",
    "daisyui": "^5.5.14",
    "echarts": "^6.0.0",
    "hash-wasm": "^4.12.0",
    "i18n-iso-countries": "^7.14.0",
    "ml-kmeans": "^7.0.1",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.25",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.6.3",
    "vue3-calendar-heatmap": "^2.0.5",
    "zstddec": "^0.2.0"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/simple-icons": "^1.2.87",
    "@iconify/utils": "^3.1.3",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.60.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/eslint-plugin": "^1.5.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-playwright": "^2.3.0",
    "eslint-plugin-vue": "~10.5.1",
    "jiti": "^2.6.1",
    "jsdom": "^27.2.0",
    "jsonc-eslint-parser": "^3.3.0",
    "markdown-it-mathjax3": "^4.3.2",
    "medium-zoom": "^1.1.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.14",
    "vue-tsc": "^3.1.5",
    "yaml-eslint-parser": "^2.1.0"
  }
}

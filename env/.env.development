# Vite dev server proxy 目标：后端 API 实际地址
# 默认指向测试服务器（http://47.98.174.83:8000），如需连接远程服务器请在此覆盖
VITE_BACKEND_URL=http://47.98.174.83:8000

# ── SXO-Harness LLM 配置 ──
# 提供 /v1/messages 的中转站基地址，末尾的 /v1 可省略
VITE_LLM_PROXY_URL=http://47.113.198.26/v1
# 默认模型名
VITE_LLM_MODEL=mimo-v2.5

# ============================================================
# 开发环境变量
# 仅影响本地 vite dev server，不会注入生产构建产物
# ============================================================

# Vite dev server proxy 目标：后端 API 实际地址
# 测试服 https://sxo.neonexus.top 的 nginx 把 /api 转发到后端；代理会先去掉
# 浏览器的 /api 前缀，所以这里必须带上 /api（写成裸域名会请求到前端路由）。
VITE_BACKEND_URL=https://sxo.neonexus.top/api

# ── SXO-Harness LLM 配置 ──
# 提供 /v1/messages 的中转站基地址，末尾的 /v1 可省略
VITE_LLM_PROXY_URL=http://47.113.198.26/v1
# 默认模型名
VITE_LLM_MODEL=mimo-v2.5

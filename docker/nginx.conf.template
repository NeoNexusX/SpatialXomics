# ============================================================
# Nginx 配置模板
# 容器启动时由 entrypoint.sh 通过 envsubst 将 ${BACKEND_HOST}/${BACKEND_PORT}
# 替换为实际值，生成最终 default.conf。
#
# 职责：
#   1. 服务前端静态文件（dist/）
#   2. /api 代理到后端
#   3. Vue Router history 模式 SPA fallback
# ============================================================

# 所有浏览器共享这一上游配额，避免同一服务器 IP 超过 KEGG 的 3 次/秒限制。
limit_req_zone $server_name zone=kegg_rest:1m rate=3r/s;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ---- 压缩 ----
    # gzip_static / brotli_static：优先返回构建期预生成的 .gz / .br（见 vite.config.ts 的
    # precompressAssets 插件）。命中时 nginx 直接发文件，不做任何运行时压缩。
    # 未预压缩的响应（如 /api 代理回来的 JSON）才走下面的运行时 gzip 兜底。
    #
    # 实测本项目最大的 index CSS（190KB 原始）：
    #   运行时 gzip level 1（改前的默认值） 40.3KB
    #   运行时 gzip level 6                32.0KB
    #   预压缩 gzip -9                     31.7KB
    #   预压缩 brotli q11                  25.7KB  ← 比改前省 36%
    gzip_static on;
    brotli_static on;

    gzip on;
    gzip_comp_level 6;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 256;

    # 静态资源长缓存（带 hash 的文件名）
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # KEGG 官方 API 的固定同源转发；浏览器不下载离线索引。
    location /kegg-rest/ {
        limit_req zone=kegg_rest burst=10;
        limit_req_status 429;
        proxy_pass https://rest.kegg.jp/;
        proxy_set_header Host rest.kegg.jp;
        proxy_ssl_server_name on;
        proxy_ssl_name rest.kegg.jp;
        proxy_connect_timeout 10s;
        proxy_read_timeout 25s;
        limit_except GET { deny all; }
    }

    # API 代理 → 后端服务
    # ${BACKEND_HOST} 和 ${BACKEND_PORT} 由 docker run -e 传入
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 超时配置（适配大文件上传/处理场景）
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 10g;
    }

    # VitePress 文档站静态资源长缓存（资源在 /docs/assets/，不走上面的 /assets/）
    location /docs/assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # /docs（不带斜杠）不满足下面 /docs/ 的前缀匹配，会被 SPA 的 location / 兜底接管，
    # 错误地返回主应用首页。这里精确匹配并 301 到带斜杠的地址，再交给 /docs/ 处理。
    location = /docs {
        return 301 /docs/;
    }

    # VitePress 文档站：独立 fallback，落 VitePress 自己的 404.html，
    # 不被前端 SPA 的 index.html 接管。$uri.html 兼容 cleanUrls 开/关。
    # root 继承自 server 块：/docs/ 映射到 /usr/share/nginx/html/docs/
    location /docs/ {
        index index.html;
        try_files $uri $uri.html $uri/ /docs/404.html;
    }

    # SPA fallback：所有非文件路径返回 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}

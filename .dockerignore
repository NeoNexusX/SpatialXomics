# Docker 构建忽略文件
node_modules
dist
# .git 不排除：VitePress 的 lastUpdated 功能要在构建时读 git log（见 docker/Dockerfile）
.github
.gitignore
*.md
# 防呆：确保 VitePress 文档源文件始终进入构建上下文
!docs/**
# env 目录中只保留生产构建需要的文件，其余不打包
env/.env.development
env/.env.development.local
__screenshots__
test-results/
playwright-report/
coverage/
.playwright-cli/
output/

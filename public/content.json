        {
          "en": "GBK/GB18030 support for annotation CSV",
          "zh-CN": "注释 CSV 支持 GBK 编码"
        },
        {
          "en": "Gray out Gamma and display range during multi-ion overlay",
          "zh-CN": "多离子叠加时置灰不适用控件"
        },
        {
          "en": "Documentation overhaul: unified guides and account pages",
          "zh-CN": "文档大更新：指南统一与账号管理重写"
        }
      ]

  "features": {
    "items": [
      {
        "word": { "en": "VISUAL", "zh-CN": "可视化" },
        "title": {
          "en": "From Mass Signals to Spatial Distributions",
          "zh-CN": "从质谱信号到空间分布"
        },
        "desc": {
          "en": "Ion images, mass spectra, and clustering maps intuitively reveal signal distributions and tissue structures. Multi-ion overlays and spatial mapping let you examine regional differences from multiple perspectives.",
          "zh-CN": "通过离子图、质谱与聚类图，直观呈现信号分布和组织结构。支持多离子叠加与空间映射，从不同角度观察数据中的区域差异。"
        },
        "image": "https://neonexus-picture.oss-ap-southeast-1.aliyuncs.com/test/mz726.539885.png"
      },
      {
        "word": { "en": "INTERACTIVE", "zh-CN": "可交互" },
        "title": {
          "en": "Linked Views, Explore Data on Demand",
          "zh-CN": "多视图联动，按需探索数据"
        },
        "desc": {
          "en": "Search ions, inspect pixel spectra, and select and compare regions — all within linked views. Drill down from whole-slide distributions to local regions, keeping observation and analysis in one flow.",
          "zh-CN": "支持离子检索、像素谱查看、区域选择与比较，在联动视图中探索感兴趣的信号。从整体分布深入局部区域，让观察与分析紧密衔接。"
        },
        "image": "https://neonexus-picture.oss-ap-southeast-1.aliyuncs.com/test/kmeans_image2.png"
      },
      {
        "word": { "en": "SCALABLE", "zh-CN": "可扩展" },
        "title": {
          "en": "Elastic Cloud Computing at Any Scale",
          "zh-CN": "弹性云计算，适应数据规模"
        },
        "desc": {
          "en": "Built on a cloud-native architecture that schedules compute resources per task, it meets data-processing demands of any scale. Cloud preprocessing works hand in hand with in-browser analysis, easing the burden on local hardware.",
          "zh-CN": "依托云原生架构，按任务调度计算资源，满足不同规模的数据处理需求。云端预处理与浏览器端分析协同，减轻本地配置与算力负担。"
        },
        "image": "https://neonexus-picture.oss-ap-southeast-1.aliyuncs.com/test/umap_image2.png"
      }
    ]
  },
  "timeline": [
    {
      "date": {

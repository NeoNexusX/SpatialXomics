  "timeline": [
    {
      "date": {
        "en": "October 9",
        "zh-CN": "10月9日"
      },
      "version": "0.7.4",
      "features": [
        {
          "en": "AI Agent platform with multi-evidence annotation scoring",
          "zh-CN": "AI Agent 平台与注释多证据打分"
        },
        {
          "en": "ROI selection highlights the main image and exports masks",
          "zh-CN": "ROI 勾选联动主图高亮与掩膜导出"
        },
        {
          "en": "Annotation CSV decoding with GBK/GB18030 fallback",
          "zh-CN": "注释 CSV 解码支持 GBK/GB18030 回退"
        },
        {
          "en": "Gamma and display range gray out while multi-ion overlay is active",
          "zh-CN": "多离子叠加激活时置灰 Gamma 与显示范围控件"
        },
        {
          "en": "Documentation overhaul: unified bilingual guides, collections usage and account management",
          "zh-CN": "文档大更新：中英指南基名统一、集合使用指南与账号管理重写"
        },
        {
          "en": "E2E test suite overhaul: full-route coverage, clipboard/overlay tests and stable cross-browser downloads",
          "zh-CN": "E2E 测试体系重构：全路由覆盖、剪贴板/叠加用例与跨浏览器下载稳定化"
        }
      ]
    },
    {
      "date": {
        "en": "September 24",
        "zh-CN": "9月24日"
      },
      "version": "0.7.3",
      "features": [
        {
          "en": "Collections v2 revamp with metadata vocabulary integration",
          "zh-CN": "集合中心 v2 改版，元数据接入词表"
        },
        {
          "en": "One-click clipboard copy for share links across pages",
          "zh-CN": "分享链接一键复制（跨页面统一）"
        },
        {
          "en": "Collections migrated to public_id; private datasets shareable without going public",
          "zh-CN": "集合接口迁移 public_id；私有数据集可直接分享，不再强制设公开"
        },
        {
          "en": "Unified loading skeletons and UI consistency polish",
          "zh-CN": "加载骨架统一与界面一致性优化"
        }
      ]
    },
    {
      "date": {
        "en": "September 17",
        "zh-CN": "9月17日"
      },
      "version": "0.7.2",
      "features": [
        {
          "en": "Multi-select filtering and server-side search for datasets and collections",
          "zh-CN": "数据集与集合筛选支持多选，搜索改为服务端处理"
        },
        {
          "en": "Shareable public file pages via non-enumerable links (no sign-in required)",
          "zh-CN": "文件公开分享页：不可枚举链接，免登录访问"
        },
        {
          "en": "Share private datasets in one click via make-public confirmation",
          "zh-CN": "私有数据集一键分享（确认设为公开后自动复制链接）"
        },
        {
          "en": "Visualization workbench: 10-color ion channels, per-layer opacity and mask export polish",
          "zh-CN": "可视化工作台：离子通道扩至十色、逐层透明度与蒙版导出优化"
        }
      ]
    }

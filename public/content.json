  "features": {
    "items": [
      {
        "word": "OPEN",
        "title": {
          "en": "Open & Interoperable",
          "zh-CN": "开放与互通"
        },
        "desc": {
          "en": "Designed with an open-source spirit from the ground up, we break down data silos, enable open knowledge sharing, and collectively advance the spatial omics community.",
          "zh-CN": "秉持开源精神打造，打破数据孤岛，促进知识共享，共同推动空间组学领域发展。"
        },
        "image": "https://neonexus-picture.oss-ap-southeast-1.aliyuncs.com/test/mz726.539885.png"
      },
      {
        "word": "SMART",
        "title": {
          "en": "SMART Analysis",
          "zh-CN": "智能分析"
        },
        "desc": {
          "en": "Powered by cloud-native infrastructure and AI, every analysis becomes faster, smarter, and more accessible to researchers at any scale.",
          "zh-CN": "依托云原生基础设施与人工智能，让每一次分析更快、更智能，也让不同规模的研究者都能轻松使用。"
        },
        "image": "https://neonexus-picture.oss-ap-southeast-1.aliyuncs.com/test/kmeans_image2.png"
      },
      {
        "word": "FAST",
        "title": {
          "en": "Fast at Scale",
          "zh-CN": "规模化高速处理"
        },
        "desc": {
          "en": "Backed by a homegrown computing framework and cloud-native infrastructure, SpatialXomics delivers high-performance computation that scales effortlessly with your data.",
          "zh-CN": "基于自主研发的计算框架和云原生基础设施，SpatialXomics 提供可随数据规模灵活扩展的高性能计算能力。"
        },
        "image": "https://neonexus-picture.oss-ap-southeast-1.aliyuncs.com/test/umap_image2.png"
      }
    ]
  },
  "timeline": [
    {
      "date": {
        "en": "October 21",
        "zh-CN": "10月21日"
      },
      "version": "0.7.5",
      "features": [
        {
          "en": "Region comparison upgrade: NPZ mask import alongside drawn ROIs and KMeans clusters",
          "zh-CN": "区域比较升级：支持导入 NPZ 掩膜，与绘制 ROI、KMeans 簇同列比较区域"
        },
        {
          "en": "Differential and enriched ion export from comparison results (A-only, B-only, A-enriched, B-enriched)",
          "zh-CN": "比较结果支持差异与富集离子导出（A 独有、B 独有、A 富集、B 富集）"
        },
        {
          "en": "New reference database page (HMDB): keyword / origin / mass-range filtering and full-library CSV download",
          "zh-CN": "新增参考数据库页（HMDB）：关键词、来源、质量区间筛选与整库 CSV 下载"
        },
        {
          "en": "Import full annotation libraries from the platform reference database, reused locally without re-downloading",
          "zh-CN": "注释可从平台参考库整库导入，本地保存复用、不重复下载"
        },
        {
          "en": "New database guide (zh/en), annotation guide updates and navigation polish",
          "zh-CN": "新增数据库指南（中英）、注释指南更新与导航细节优化"
        }
      ]
    },
    {
      "date": {
        "en": "October 9",
        "zh-CN": "10月9日"
      },
      "version": "0.7.4",
      "features": [
        {
          "en": "AI Agent platform with multi-evidence annotation scoring",
          "zh-CN": "AI Agent 平台与注释多证据打分"
        },
        {
          "en": "ROI selection highlights the main image and exports masks",
          "zh-CN": "ROI 勾选联动主图高亮与掩膜导出"
        },
        {
          "en": "Annotation CSV decoding with GBK/GB18030 fallback",
          "zh-CN": "注释 CSV 解码支持 GBK/GB18030 回退"
        },
        {
          "en": "Gamma and display range gray out while multi-ion overlay is active",
          "zh-CN": "多离子叠加激活时置灰 Gamma 与显示范围控件"
        },
        {
          "en": "Documentation overhaul: unified bilingual guides, collections usage and account management",
          "zh-CN": "文档大更新：中英指南基名统一、集合使用指南与账号管理重写"
        },
        {
          "en": "E2E test suite overhaul: full-route coverage, clipboard/overlay tests and stable cross-browser downloads",
          "zh-CN": "E2E 测试体系重构：全路由覆盖、剪贴板/叠加用例与跨浏览器下载稳定化"
        }
      ]
    },
    {
      "date": {
        "en": "September 24",
        "zh-CN": "9月24日"
      },
      "version": "0.7.3",
      "features": [
        {
          "en": "Collections v2 revamp with metadata vocabulary integration",
          "zh-CN": "集合中心 v2 改版，元数据接入词表"
        },
        {
          "en": "One-click clipboard copy for share links across pages",
          "zh-CN": "分享链接一键复制（跨页面统一）"
        },
        {
          "en": "Collections migrated to public_id; private datasets shareable without going public",
          "zh-CN": "集合接口迁移 public_id；私有数据集可直接分享，不再强制设公开"
        },
        {
          "en": "Unified loading skeletons and UI consistency polish",
          "zh-CN": "加载骨架统一与界面一致性优化"
        }
      ]
    }
  ],
